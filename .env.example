# Database
DATABASE_URL=postgresql://warranty_user:warranty_pass@postgres:5432/warranty

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=warranty-platform-poc
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/warranty-processing-queue

# Qdrant (use http://qdrant:6333 for the bundled local container, or a Qdrant Cloud URL)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=warranty_chunks

# LLMs
OPENAI_API_KEY=
SMALL_MODEL=gpt-5.4-mini
LARGE_MODEL=gpt-5.5
ANTHROPIC_API_KEY=

# Service Ports
BACKEND_PORT=3001
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Auth
JWT_SECRET=
JWT_EXPIRY=24h

# Service URLs
AI_SERVICE_URL=http://ai-service:8000
BACKEND_URL=http://backend:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
